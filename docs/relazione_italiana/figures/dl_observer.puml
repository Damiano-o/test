top to bottom direction

' ============================================================
' Design-level — Pattern Observer (notifica cambio stato Ordine)
' Stile event-driven (come il progetto di riferimento):
' OrdineEvent + OrdineEventListener + OrdineSubject (publisher con
' listeners) + observer concreti (VenditoreNotifier, UtenteNotifier).
' ============================================================

' ---------- Evento (dati del cambio stato) ----------
class "OrdineEvent" {
  - numeroOrdine : Long
  - totale : double
  - stato : String
  - timestamp : LocalDateTime
  - clienteId : String
  + getNumeroOrdine() : Long
  + getTotale() : double
  + getStato() : String
  + getTimestamp() : LocalDateTime
  + getClienteId() : String
}

' ---------- Interfaccia listener ----------
interface "OrdineEventListener" <<interface>> {
  + onStatoCambiato(OrdineEvent) : void
}

' ---------- Publisher (Subject) ----------
class "OrdineSubject" {
  - logger : Logger
  - instance : OrdineSubject
  - listeners : List<OrdineEventListener>
  + addListener(OrdineEventListener) : void
  + removeListener(OrdineEventListener) : void
  + clearListeners() : void
  + notifyObservers(OrdineEvent) : void
  + getListenerCount() : int
  {static} + getInstance() : OrdineSubject
}

' ---------- Controller (pubblica l'evento) ----------
class "CreaOrdineController" as CTL <<control>> {
  + confermaOrdine() : boolean
}
class "OrdinaProdottoController" as OPC <<control>> {
  + processaPagamento(...) : OrdineBean
}

' ---------- Observer concreti ----------
class "VenditoreNotifier" {
  - logger : Logger
  + onStatoCambiato(OrdineEvent) : void
  + notificaPopup(OrdineEvent) : void
}
class "UtenteNotifier" {
  - logger : Logger
  + onStatoCambiato(OrdineEvent) : void
}

' ============================================================
' Relazioni
' ============================================================
' Publisher usa l'evento e notifica i listener
OrdineSubject ..> OrdineEvent : genera/notifica
OrdineEventListener ..> OrdineEvent : <<use>> param
OrdineSubject "1" o-- "*" OrdineEventListener : listeners

' interfaccia realizzata dagli observer concreti
VenditoreNotifier ..|> OrdineEventListener
UtenteNotifier ..|> OrdineEventListener

' controller pubblica l'evento via publisher
OPC ..> OrdineSubject : <<use>>\ngetInstance().notify
CTL ..> OrdineSubject : <<use>>\npubblica evento

' il publisher è un singleton: una sola istanza
OrdineSubject::instance --> OrdineSubject : "tiene l'unica\nistanza"

@enduml