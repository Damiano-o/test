@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
skinparam classFontSize 12
skinparam classAttributeFontSize 11
left to right direction

' ============================================================
' Design-level — DAO Abstract Factory (NFR-01 persistenza)
' Stile conciso (come progetti 30/30): factory astratta,
' concrete factory + interfacce DAO, frecce <<create>> esplicite.
' ============================================================

' ---------- Client (control) ----------
class "OrdinaProdottoController" as CTL <<control>> {
  - utenteDAO : UtenteDAO
  - prodottoDAO : ProdottoDAO
  - ordineDAO : OrdineDAO
  - buonoDAO : BuonoDAO
}

' ---------- Abstract Factory ----------
class "ApplicationModeManager" <<singleton>> {
  - factory : DAOFactory
  + getInstance() : ApplicationModeManager
  + getDAOFactory() : DAOFactory
}
interface "DAOFactory" <<interface>> {
  + getUtenteDAO() : UtenteDAO
  + getProdottoDAO() : ProdottoDAO
  + getOrdineDAO() : OrdineDAO
  + getBuonoDAO() : BuonoDAO
}

class "DemoDAOFactory"
class "FSDAOFactory"
class "JDBCDAOFactory"
DemoDAOFactory ..|> DAOFactory
FSDAOFactory  ..|> DAOFactory
JDBCDAOFactory ..|> DAOFactory

' ---------- Abstract Products (DAO) ----------
interface "UtenteDAO" <<interface>>
interface "ProdottoDAO" <<interface>>
interface "OrdineDAO" <<interface>>
interface "BuonoDAO" <<interface>>

' ---------- Concrete Products (una famiglia esemplificativa, per concisione) ----------
class "JDBCUtenteDAO"
class "JDBCProdottoDAO"
class "JDBCOrdineDAO"
class "JDBCBuonoDAO"
JDBCUtenteDAO ..|> UtenteDAO
JDBCProdottoDAO ..|> ProdottoDAO
JDBCOrdineDAO ..|> OrdineDAO
JDBCBuonoDAO ..|> BuonoDAO

' ---------- relazioni: controller -> factory -> prodotti ----------
OrdinaProdottoController --> ApplicationModeManager : <<use>>\n' getInstance()'
ApplicationModeManager --> DAOFactory : <<create>> getDAOFactory()
JDBCDAOFactory ..> JDBCUtenteDAO : <<create>>
JDBCDAOFactory ..> JDBCProdottoDAO : <<create>>
JDBCDAOFactory ..> JDBCOrdineDAO : <<create>>
JDBCDAOFactory ..> JDBCBuonoDAO : <<create>>

' i DAO concrete per le altre famiglie sono omessi per concisione
' (stessa struttura di JDBC)

note bottom of DAOFactory
  DemoDAOFactory e FSDAOFactory
  producono la stessa famiglia di DAO
  (Demo/FS* implementano le stesse interfacce).
end note

@enduml