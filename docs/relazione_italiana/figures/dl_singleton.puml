@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam nodesep 55
skinparam ranksep 55
skinparam classFontSize 12
skinparam classAttributeFontSize 11
top to bottom direction

' ============================================================
' Design-level — Singleton (sessione utente)
' Stile EventBus: Holder idiom con <<static nested>> e freccia
' "Holds unique instance".
' ============================================================

' ---------- Client / chi usa il Singleton ----------
class "LoginView" {
  + build() : Parent
}
class "MarketplaceView" {
  + build() : Parent
}
class "OrdinaProdottoController" <<control>> {
  + (usa la sessione per l'utente corrente)
}

LoginView --> SessionManager : getLoggedUser()
MarketplaceView --> SessionManager : getLoggedUser()
OrdinaProdottoController --> SessionManager : utente in checkout

' ---------- Singleton ----------
class "SessionManager" {
  - loggedUser : UtenteBean
  - ordineInCorso : OrdineBean
  - SessionManager()
  {static} + getInstance() : SessionManager
  + getLoggedUser() : UtenteBean
  + setLoggedUser(UtenteBean) : void
  + getOrdineInCorso() : OrdineBean
  + setOrdineInCorso(OrdineBean) : void
  + logout() : void
}

' ---------- Holder (istanza unica) ----------
class "«static nested»\nHolder" as HOLDER <<static nested>> {
  {static} + INSTANCE : SessionManager
}

SessionManager +-- HOLDER : "Holds unique\ninstance"
HOLDER ..> SessionManager : crea

@enduml