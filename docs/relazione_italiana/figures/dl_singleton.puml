@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam nodesep 50
skinparam ranksep 45
skinparam classFontSize 12
skinparam classAttributeFontSize 11
top to bottom direction

' ============================================================
' Design-level — Singleton (sessione utente e modalità applicativa)
' Stile EventBus/Container: classe client -> Singleton,
' <<static nested>> Container con INSTANCE, freccia "Holds unique instance".
' ============================================================

' ---------- Client / chi usa il Singleton ----------
class "LoginView" {
  + build() : Parent
}
class "MarketplaceView" {
  + build() : Parent
}
class "OrdinaProdottoController" <<control>> {
  + usa la sessione
  + getDAOFactory()
}

' ---------- Singleton 1: sessione utente ----------
class "SessionManager" {
  - loggedUser : UtenteBean
  - ordineInCorso : OrdineBean
  - SessionManager()
  {static} + getInstance() : SessionManager
  + getLoggedUser() : UtenteBean
  + setLoggedUser(UtenteBean) : void
  + getOrdineInCorso() : OrdineBean
  + setOrdineInCorso(OrdineBean) : void
  + logout() : void
}

class "Container" as H1 <<static nested>> {
  {static} + INSTANCE : SessionManager
}
SessionManager +-- H1 : "Holds unique\ninstance"
H1 ..> SessionManager : crea

' ---------- Singleton 2: modalità applicativa ----------
class "ApplicationModeManager" {
  - activeMode : String
  - factory : DAOFactory
  - ApplicationModeManager()
  {static} + getInstance() : ApplicationModeManager
  + getActiveMode() : String
  + setActiveMode(String) : void
  + getDAOFactory() : DAOFactory
}

class "Container" as H2 <<static nested>> {
  {static} + INSTANCE : ApplicationModeManager
}
ApplicationModeManager +-- H2 : "Holds unique\ninstance"
H2 ..> ApplicationModeManager : crea

' ---------- usi ----------
LoginView --> SessionManager : getLoggedUser()
MarketplaceView --> SessionManager : getLoggedUser()
OrdinaProdottoController --> SessionManager : utente in checkout
OrdinaProdottoController --> ApplicationModeManager : getDAOFactory()

@enduml